// TEMPLATE ONLY. Not a working app and intentionally not at the repo root.
// The agent must create src/worker.ts and public/ first, verify the Free plan,
// copy/adapt this config, replace placeholders, and test before deploying.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "duegood",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-13",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "vars": {
    "APP_ORIGIN": "https://REPLACE_WITH_ACTUAL_ORIGIN.workers.dev",
    "CANVAS_ORIGIN": "https://marymount.instructure.com",
    "CANVAS_CLIENT_ID": "REPLACE_AFTER_ADMIN_ENABLEMENT",
    "AUTH_MODE": "disabled",
    "REGISTRATION_ENABLED": "false",
    "SYNC_ENABLED": "false",
    "TOKEN_KEY_VERSION": "1",
    "PILOT_MAX_ACCOUNTS": "25",
    "SYNC_COOLDOWN_SECONDS": "900"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "duegood",
      "database_id": "REPLACE_WITH_ACTUAL_D1_ID",
      "migrations_dir": "migrations"
    }
  ]
  // No cron, queues, paid integrations, or secrets in vars.
  // Implement/validate these proposed feature flags; config alone enforces nothing.
}
