{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.duegood.invalid/canvas-capture/v2.json",
  "title": "Due Good private Canvas browser capture",
  "description": "Versioned local handoff from the operator-run browser reader to the native Tauri importer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "runId", "generationId", "capturedAt", "identity", "complete", "activeCourses", "coverageRequirements", "resources", "coverage"],
  "$defs": {
    "rubricRating": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": ["string", "null"] },
        "long_description": { "type": ["string", "null"] },
        "points": { "type": ["number", "null"] }
      }
    },
    "rubricCriterion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": ["integer", "string"] },
        "description": { "type": ["string", "null"] },
        "long_description": { "type": ["string", "null"] },
        "points": { "type": ["number", "null"] },
        "ratings": { "type": ["array", "null"], "items": { "$ref": "#/$defs/rubricRating" } }
      }
    },
    "assignmentRubricFields": {
      "type": "object",
      "properties": {
        "rubric": {
          "description": "New assignment captures explicitly record null when Canvas returns no rubric. Older archives may lack this field.",
          "type": ["array", "null"],
          "items": { "$ref": "#/$defs/rubricCriterion" }
        },
        "rubric_settings": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "title": { "type": ["string", "null"] },
            "points_possible": { "type": ["number", "null"] },
            "free_form_criterion_comments": { "type": ["boolean", "null"] }
          }
        },
        "use_rubric_for_grading": { "type": ["boolean", "null"] }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 2 },
    "source": { "const": "canvas-browser" },
    "runId": { "type": "integer", "minimum": 1 },
    "generationId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "complete": { "type": "boolean", "description": "True only when all accessible data and applicable file bodies were captured and verified. Recorded access omissions may remain." },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "userId"],
      "properties": {
        "origin": { "const": "https://marymount.instructure.com" },
        "userId": { "type": "integer", "minimum": 1 },
        "accountId": { "type": "integer", "minimum": 1 }
      }
    },
    "activeCourses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "courseIds"],
      "properties": {
        "complete": { "const": true },
        "courseIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "coverageRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeCoursesComplete", "perActiveCourse"],
      "properties": {
        "activeCoursesComplete": { "const": true },
        "perActiveCourse": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 4,
          "maxItems": 4,
          "items": { "enum": ["course", "assignments", "assignmentGroups", "submissions"] }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["endpoint", "courseId", "items", "pages"],
        "allOf": [
          {
            "if": { "properties": { "endpoint": { "const": "assignments" } } },
            "then": { "properties": { "items": { "items": { "$ref": "#/$defs/assignmentRubricFields" } } } }
          },
          {
            "if": { "properties": { "endpoint": { "const": "discussions" } } },
            "then": { "properties": { "items": { "items": { "properties": { "assignment": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/assignmentRubricFields" }] } } } } } }
          }
        ],
        "properties": {
          "endpoint": {
            "enum": ["profile", "coursesActive", "coursesCompleted", "course", "syllabus", "courseTabs", "assignments", "assignmentGroups", "submissions", "submission", "pages", "page", "modules", "moduleItems", "discussions", "discussionEntries", "discussionReplies", "announcements", "quizzes", "quiz", "courseFiles", "folders", "groups", "personalFiles", "personalFolders", "personalFile", "inbox", "inboxAll", "conversationsSent", "conversationsArchived", "conversation", "file", "fileBodies", "calendarEvents"]
          },
          "courseId": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
          "groupId": { "type": "integer", "minimum": 1 },
          "contextCode": { "type": "string", "pattern": "^(user|course|group|account)_[1-9][0-9]*$" },
          "items": { "type": "array", "description": "File metadata can come from listings or an individual lookup for an attachment or same-origin file link in an assignment, discussion topic, entry, reply, page or announcement. For fileBodies, a gap receipt with reason empty records an explicitly zero-size Canvas file whose successful download yielded zero bytes. It has no archived blob.", "items": { "type": "object" } },
          "pages": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["endpoint", "courseId", "status"],
        "if": { "required": ["reason"], "properties": { "reason": { "const": "empty" } } },
        "then": { "properties": { "endpoint": { "const": "fileBodies" }, "status": { "const": "gap" } } },
        "properties": {
          "endpoint": { "type": "string", "minLength": 1 },
          "courseId": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
          "groupId": { "type": "integer", "minimum": 1 },
          "contextCode": { "type": "string", "pattern": "^(user|course|group|account)_[1-9][0-9]*$" },
          "status": { "enum": ["complete", "incomplete", "gap"] },
          "reason": { "enum": ["empty", "forbidden-optional", "disabled", "not-attempted", "not-found", "request-failed", "pagination-budget", "capture-budget", "detail-budget", "invalid-slug", "locked", "not-applicable", "parent-unavailable", "unpublished", "unsupported"] }
        }
      }
    }
  }
}
