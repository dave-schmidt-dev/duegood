{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.duegood.invalid/canvas-capture/v2.json",
  "title": "Due Good private Canvas browser capture",
  "description": "Versioned local handoff from the operator-run browser reader to the native Tauri importer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "runId", "generationId", "capturedAt", "identity", "complete", "activeCourses", "coverageRequirements", "resources", "coverage"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "source": { "const": "canvas-browser" },
    "runId": { "type": "integer", "minimum": 1 },
    "generationId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "complete": { "type": "boolean" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "userId"],
      "properties": {
        "origin": { "const": "https://marymount.instructure.com" },
        "userId": { "type": "integer", "minimum": 1 },
        "accountId": { "type": "integer", "minimum": 1 }
      }
    },
    "activeCourses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "courseIds"],
      "properties": {
        "complete": { "const": true },
        "courseIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "coverageRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeCoursesComplete", "perActiveCourse"],
      "properties": {
        "activeCoursesComplete": { "const": true },
        "perActiveCourse": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 4,
          "maxItems": 4,
          "items": { "enum": ["course", "assignments", "assignmentGroups", "submissions"] }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["endpoint", "courseId", "items", "pages"],
        "properties": {
          "endpoint": {
            "enum": ["profile", "coursesActive", "coursesCompleted", "course", "syllabus", "courseTabs", "assignments", "assignmentGroups", "submissions", "submission", "pages", "page", "modules", "moduleItems", "discussions", "discussionEntries", "discussionReplies", "announcements", "quizzes", "quiz", "courseFiles", "folders", "groups", "personalFiles", "personalFolders", "personalFile", "inbox", "inboxAll", "conversationsSent", "conversationsArchived", "conversation", "file", "fileBodies", "calendarEvents"]
          },
          "courseId": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
          "groupId": { "type": "integer", "minimum": 1 },
          "contextCode": { "type": "string", "pattern": "^(user|course|group|account)_[1-9][0-9]*$" },
          "items": { "type": "array", "items": { "type": "object" } },
          "pages": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["endpoint", "courseId", "status"],
        "properties": {
          "endpoint": { "type": "string", "minLength": 1 },
          "courseId": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
          "groupId": { "type": "integer", "minimum": 1 },
          "contextCode": { "type": "string", "pattern": "^(user|course|group|account)_[1-9][0-9]*$" },
          "status": { "enum": ["complete", "incomplete", "gap"] },
          "reason": { "enum": ["forbidden-optional", "disabled", "not-attempted", "not-found", "request-failed", "pagination-budget", "capture-budget"] }
        }
      }
    }
  }
}
